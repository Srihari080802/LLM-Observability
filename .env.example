# Copy this file to .env and fill in your values:  cp .env.example .env

# --- LLM provider ---
# Options: google | openai | fake
#   fake = run the whole stack with NO API key (canned responses)
PROVIDER=fake

# Model override. Leave blank to use the provider default
# (gemini-2.5-flash for google, gpt-4o-mini for openai).
MODEL=

# Your API key. Required unless PROVIDER=fake.
GEMINI_API_KEY=your-gemini-key-here
OPENAI_API_KEY=

# How many past turns to send to the model as context.
CONTEXT_WINDOW=10

# --- log transport ---
# events = SDK publishes log events to a Redis Stream, ingestion
#          consumes them (the event-based architecture, recommended).
# http   = SDK POSTs logs directly to the ingestion API (no broker).
LOG_TRANSPORT=events
